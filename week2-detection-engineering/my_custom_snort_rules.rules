# -----------------------------------------------------------------------------
# DETECTON ENGINEERING: CUSTOM SNORT/SURICATA RULES
# -----------------------------------------------------------------------------

# RULE 1: DIRECT IP BLOCK (Python Scriptimizin Yakaladığı Düşman)
# 10.62.118.50 IP'sinden bizim ağımıza gelen TÜM TCP trafiğini yakala ve alarm üret.
alert tcp 10.62.118.50 any -> $HOME_NET any (msg:"CRITICAL: Known Malicious IP (Brute-Force Attacker) Detected!"; sid:1000001; rev:1;)

# RULE 2: BEHAVIORAL ANALYSIS (Davranışsal SSH Brute-Force Tespiti)
# Herhangi bir dış IP'den, bizim SSH portumuza (22) 60 saniye içinde 5'ten fazla bağlantı isteği gelirse uyar.
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"WARNING: Possible SSH Brute-Force Attack in Progress!"; flow:to_server,established; threshold:type both, track by_src, count 5, seconds 60; sid:1000002; rev:1;)

# RULE 3: PING OF DEATH / ICMP FLOOD (DDoS Tespiti)
# Ağı felç etmek için ardı ardına devasa PING (ICMP) paketi atanları sınırla.
alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"WARNING: ICMP Flood (Ping) DDoS Attempt!"; itype:8; threshold:type limit, track by_src, count 50, seconds 10; sid:1000003; rev:1;)
